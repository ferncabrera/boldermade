{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*.ts", "**/*.astro", "**/*.tsx"],
  "exclude": ["dist", "node_modules", "html", "css"],
  "compilerOptions": {
    "strictNullChecks": true,
    "allowJs": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "baseUrl": ".",
    "paths": { "~/*": ["src/*"] }
  }
}
