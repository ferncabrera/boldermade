---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbLd } from '../lib/seo.ts';
const jsonLd = [breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Ring sizing', path: '/sizing' }])];
---
<BaseLayout
  title="Ring sizing"
  description="How to find your ring size at home before ordering a handmade bolder ring — string method, existing-ring method, and what to do if you're between sizes."
  path="/sizing"
  jsonLd={jsonLd}
>
  <div class="container section">
    <div class="page prose">
      <h1>Ring sizing</h1>
      <p class="lede">
        Most bolder pieces are one of a kind and listed at a fixed size. Made-to-order designs let
        you choose. Here’s how to work out which size you need.
      </p>

      <h2>Measure a ring you already own</h2>
      <p>
        The most reliable method. Take a ring that fits the finger you have in mind, and measure the
        <strong>inside</strong> diameter across the widest point in millimetres. Match that against
        the chart below.
      </p>

      <h2>The string method</h2>
      <p>
        Wrap a strip of paper or a piece of string around the base of your finger, mark where it
        overlaps, then measure the length in millimetres. That’s your circumference.
      </p>

      <table class="chart">
        <caption class="visually-hidden">Ring size conversion</caption>
        <thead>
          <tr><th scope="col">US size</th><th scope="col">Inside diameter</th><th scope="col">Circumference</th></tr>
        </thead>
        <tbody>
          <tr><td>5</td><td>15.7 mm</td><td>49.3 mm</td></tr>
          <tr><td>6</td><td>16.5 mm</td><td>51.9 mm</td></tr>
          <tr><td>7</td><td>17.3 mm</td><td>54.4 mm</td></tr>
          <tr><td>8</td><td>18.1 mm</td><td>57.0 mm</td></tr>
          <tr><td>9</td><td>19.0 mm</td><td>59.5 mm</td></tr>
          <tr><td>10</td><td>19.8 mm</td><td>62.1 mm</td></tr>
          <tr><td>11</td><td>20.6 mm</td><td>64.6 mm</td></tr>
          <tr><td>12</td><td>21.4 mm</td><td>67.2 mm</td></tr>
        </tbody>
      </table>

      <h2>A few things worth knowing</h2>
      <ul>
        <li>Fingers swell in heat and late in the day — measure when you’re warm, not cold.</li>
        <li>Wide bands fit more snugly than thin ones. If a ring is chunky, consider a half size up.</li>
        <li>Statement rings with large stones sit high; that doesn’t change the size, but it changes the feel.</li>
        <li>Between sizes? <a href="/contact">Ask me</a> — I’d rather talk it through than have it not fit.</li>
      </ul>
    </div>
  </div>
</BaseLayout>
<style>
  .page { max-width: var(--w-prose); }
  .page h1 { margin-bottom: var(--s-4); }
  .chart { width: 100%; border-collapse: collapse; margin-block: var(--s-5); font-size: var(--t-sm); }
  .chart th, .chart td { text-align: left; padding: var(--s-3) var(--s-2); border-bottom: 1px solid var(--c-border); }
  .chart thead th { color: var(--c-text-muted); font-weight: 500; text-transform: uppercase; letter-spacing: var(--ls-wide); font-size: var(--t-xs); }
</style>
