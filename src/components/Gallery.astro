---
import type { ProductImage } from '../lib/catalog.ts';
import { imgUrl, srcSet, HERO_WIDTHS } from '../lib/images.ts';

interface Props { images: ProductImage[]; title: string }
const { images, title } = Astro.props;
const [first, ...rest] = images;
---

<div class="gallery" data-gallery>
  <div class="gallery__main">
    {first && (
      <img
        data-gallery-main
        src={imgUrl(first.key, { width: 1280 })}
        srcset={srcSet(first.key, HERO_WIDTHS)}
        sizes="(max-width: 60rem) 100vw, 55vw"
        alt={first.alt}
        width="1280"
        height="1600"
        fetchpriority="high"
        decoding="async"
      />
    )}
  </div>

  {rest.length > 0 && (
    <ul class="gallery__thumbs" role="list" aria-label={`More photos of ${title}`}>
      {images.map((img, i) => (
        <li>
          <button
            type="button"
            class:list={['gallery__thumb', i === 0 && 'is-active']}
            data-thumb
            data-src={imgUrl(img.key, { width: 1280 })}
            data-srcset={srcSet(img.key, HERO_WIDTHS)}
            data-alt={img.alt}
            aria-label={`View photo ${i + 1}`}
          >
            <img src={imgUrl(img.key, { width: 200 })} alt="" width="100" height="125" loading="lazy" decoding="async" />
          </button>
        </li>
      ))}
    </ul>
  )}
</div>

<style>
  .gallery { display: grid; gap: var(--s-3); }
  .gallery__main {
    aspect-ratio: 4 / 5;
    background: var(--c-bg-sunken);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .gallery__main img { width: 100%; height: 100%; object-fit: cover; }

  .gallery__thumbs {
    list-style: none; margin: 0; padding: 0;
    display: flex; gap: var(--s-2);
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .gallery__thumb {
    padding: 0; border: 1px solid transparent; background: none;
    border-radius: var(--r-sm); overflow: hidden; line-height: 0;
    width: 4.5rem; flex: 0 0 auto;
    opacity: 0.6;
    transition: opacity var(--d-fast) var(--e-out), border-color var(--d-fast) var(--e-out);
  }
  .gallery__thumb:hover { opacity: 1; }
  .gallery__thumb.is-active { opacity: 1; border-color: var(--c-text-strong); }
  .gallery__thumb img { width: 100%; height: auto; aspect-ratio: 4/5; object-fit: cover; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const main = root.querySelector<HTMLImageElement>('[data-gallery-main]');
    const thumbs = root.querySelectorAll<HTMLButtonElement>('[data-thumb]');
    if (!main) return;

    thumbs.forEach((thumb) =>
      thumb.addEventListener('click', () => {
        main.src = thumb.dataset.src!;
        main.srcset = thumb.dataset.srcset!;
        main.alt = thumb.dataset.alt ?? '';
        thumbs.forEach((t) => t.classList.toggle('is-active', t === thumb));
      })
    );
  });
</script>
